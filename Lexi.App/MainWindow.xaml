<Window x:Class="Lexi.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lexi"
    Title="LeXi" Style="{StaticResource AppWindow}" Width="720" Height="620" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterScreen"
    Icon="Assets/Lexi.ico" PreviewKeyDown="Window_KeyDown" Activated="Window_Activated">
  <Border Background="{DynamicResource WindowSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="WindowToolbar" Background="#1817171B" CornerRadius="11,11,0,0" Height="40" Padding="12,4,10,4">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="Back_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="后退"><Path Data="{StaticResource BackIcon}" Style="{StaticResource IconPath}"/></Button>
            <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="Forward_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="前进"><Path Data="{StaticResource ForwardIcon}" Style="{StaticResource IconPath}"/></Button>
          </StackPanel>
          <Border x:Name="WindowDragArea" Grid.Column="1" Background="Transparent" Cursor="SizeAll" ToolTip="拖动此处移动窗口" Margin="8,0">
            <TextBlock x:Name="WindowTitle" Text="LeXi" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click" Margin="0,0,4,0" ToolTip="设置 · Ctrl+," AutomationProperties.Name="设置"><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource IconPath}"/></Button>
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="{StaticResource CloseIcon}" Style="{StaticResource IconPath}"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="QueryBar" Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="18,2,10,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent">
            <Path Data="{StaticResource SearchIcon}" Style="{StaticResource IconPath}" Width="18" Height="18" HorizontalAlignment="Left"/>
          </Border>
          <Grid Grid.Column="1">
            <TextBox x:Name="SearchBox" FontSize="21" BorderThickness="0" Background="Transparent" Padding="0,12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown" AutomationProperties.Name="输入单词、短语或待翻译文本"/>
            <TextBlock x:Name="Placeholder" Text="查一个词，或翻译一段文字…" IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="20"/>
          </Grid>
          <StackPanel x:Name="SearchActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <local:QueryProgressView x:Name="QueryProgress" Margin="0,0,4,0"/>
            <Button Style="{StaticResource IconButton}" Click="Search_Click" ToolTip="查询 · Enter" AutomationProperties.Name="查询"><Path Data="{StaticResource EnterIcon}" Style="{StaticResource IconPath}"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="2">
        <Button x:Name="InputPreviewCard" Visibility="Collapsed" Click="InputPreview_Click" Margin="22,8,22,0"
                Padding="12,10" Background="{StaticResource AccentSoft}" BorderThickness="0"
                HorizontalContentAlignment="Stretch" Focusable="False" AutomationProperties.Name="输入释义预览">
          <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" Background="{StaticResource Accent}" CornerRadius="2">
              <Path Data="{StaticResource QuickReadMark}" Fill="{StaticResource Canvas}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
            <TextBlock x:Name="InputPreviewText" Grid.Column="1" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      <ListBox x:Name="Suggestions" Visibility="Collapsed" MaxHeight="180" Margin="12,8" Background="Transparent" BorderThickness="0" Padding="2" FontSize="17" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Suggestions_SelectionChanged" PreviewMouseLeftButtonUp="Suggestions_Click" PreviewKeyDown="SearchBox_KeyDown" IsTabStop="False" KeyboardNavigation.TabNavigation="None" AutomationProperties.Name="词条建议" AutomationProperties.HelpText="上下键选择并填入输入框，可继续编辑；Enter 查询，Tab 保留所选词，Esc 恢复原输入。"/>
      </StackPanel>
      <ScrollViewer x:Name="ResultsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,14,16,14">
        <StackPanel>
          <StackPanel x:Name="Welcome">
            <TextBlock Text="随手查，随时懂。" FontSize="26" FontWeight="SemiBold" Margin="4,13,0,8"/>
            <TextBlock Text="词语看释义，文本看翻译。" Foreground="{StaticResource Muted}" FontSize="16" Margin="4,0,0,30"/>
            <TextBlock Text="查询历史" Foreground="{StaticResource Muted}" FontSize="14" Margin="4,0,0,10"/>
            <TextBlock x:Name="HistoryMessage" Text="暂无查询历史。查过的词语和文本会显示在这里。" Foreground="{StaticResource Muted}" FontSize="15" Margin="4,4,0,12"/>
              <TextBox x:Name="HistoryFilter" TextChanged="HistoryFilter_Changed" FontSize="14" Margin="4,0,4,10" ToolTip="搜索全部查询历史" AutomationProperties.Name="搜索查询历史"/>
            <StackPanel x:Name="HistoryList"/>
              <Button x:Name="MoreHistory" Content="更多历史" Click="MoreHistory_Click" HorizontalAlignment="Left" Margin="4,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel x:Name="EntryPanel" Visibility="Collapsed">
            <TextBlock x:Name="EntryHeading" FontSize="20" Margin="0,0,0,12" TextWrapping="Wrap"><Run x:Name="Headword" FontSize="30" FontWeight="SemiBold"/><Run Text="&#160;&#160;"/><Run x:Name="Phonetic" Foreground="{StaticResource Muted}"/><Run x:Name="PhoneticLabel" FontSize="12" Foreground="{StaticResource Muted}"/><InlineUIContainer BaselineAlignment="TextBottom"><Button x:Name="SpeechButton" Click="Speech_Click" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="播放合成发音" AutomationProperties.Name="播放或停止合成发音"><Path Data="{StaticResource SpeakerIcon}" Style="{StaticResource IconPath}"/></Button></InlineUIContainer><InlineUIContainer BaselineAlignment="TextBottom"><ToggleButton x:Name="EtymologyButton" Style="{StaticResource LexicalIconToggle}" Margin="4,0,0,0" Visibility="Collapsed" ToolTip="语源 · 词的来历" AutomationProperties.Name="展开或收起语源"><Path Data="{StaticResource RosettaIcon}" Style="{StaticResource IconPath}"/></ToggleButton></InlineUIContainer></TextBlock>
            <StackPanel x:Name="FormsPanel"/>
            <Border x:Name="QuickReadCard" Visibility="Collapsed" Background="{StaticResource AccentSoft}" BorderThickness="0" CornerRadius="7" Padding="12,9,12,10" Margin="0,2,0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="QuickReadGuide" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" Background="{StaticResource Accent}" CornerRadius="2">
                  <Path x:Name="QuickReadGlyph" Data="{StaticResource QuickReadMark}" Fill="{StaticResource Canvas}" Width="14" Height="14" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
                <TextBox x:Name="QuickReadText" Grid.Column="1" Style="{StaticResource Selectable}" FontSize="19" VerticalAlignment="Center" TextBlock.LineHeight="28" TextBlock.LineStackingStrategy="BlockLineHeight">
                  <!-- Center the visible UI-font ink, which sits below the line-box center. -->
                  <TextBox.RenderTransform><TranslateTransform Y="-2"/></TextBox.RenderTransform>
                </TextBox>
                <TextBlock x:Name="QuickReadState" Grid.Column="2" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </Border>
            <StackPanel x:Name="AiPanel"/>
            <StackPanel x:Name="LocalPanel"/>
            <StackPanel x:Name="OnlinePanel"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Popup x:Name="EtymologyPopup" Grid.RowSpan="5" PlacementTarget="{Binding ElementName=EtymologyButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=EtymologyButton, Mode=TwoWay}" Opened="Etymology_Opened" PreviewKeyDown="Etymology_KeyDown">
        <Border x:Name="EtymologySurface" Width="440" Padding="18,14,18,16" Background="#F5222327" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="10" KeyboardNavigation.TabNavigation="Cycle">
          <StackPanel>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="语源 · Etymology" Foreground="{StaticResource Accent}" FontSize="18" VerticalAlignment="Center"/>
              <Button x:Name="CloseEtymology" Grid.Column="1" Style="{StaticResource IconButton}" Click="Etymology_Close" ToolTip="关闭 · Esc" AutomationProperties.Name="关闭语源"><Path Data="{StaticResource CloseIcon}" Style="{StaticResource IconPath}"/></Button>
            </Grid>
            <ScrollViewer x:Name="EtymologyScroll" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="EtymologyContent"/></ScrollViewer>
          </StackPanel>
        </Border>
      </Popup>
      <Border x:Name="StatusBar" Grid.Row="4" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="14,6">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="HistoryHomeButton" Style="{StaticResource IconButton}" Click="HistoryHome_Click" ToolTip="查询历史" AutomationProperties.Name="返回查询历史"><Border Background="{StaticResource LogoSurface}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Width="20" Height="20" CornerRadius="5"><TextBlock Text="ξ" Foreground="{StaticResource Accent}" FontFamily="Georgia" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Button>
          <TextBlock x:Name="LookupStatus" Grid.Column="1" Text="正在准备词库…" FontSize="13" Margin="10,0,12,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RetryButton" Content="重试未完成" Click="Retry_Click" Height="32" Padding="10,4" Margin="0,0,10,0" FontSize="13" Visibility="Collapsed"/>
            <Button x:Name="RefreshButton" Content="重新生成" Click="Refresh_Click" Height="32" Padding="10,4" Margin="0,0,10,0" FontSize="13" Background="{StaticResource Surface}" BorderBrush="#565861" BorderThickness="1" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="重新生成当前查询"/>
            <ToggleButton x:Name="OnlineToggle" Style="{StaticResource OnlineSwitch}" Width="112" Click="Online_Click" AutomationProperties.Name="在线补充"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
