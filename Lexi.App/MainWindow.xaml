<Window x:Class="Lexi.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lexi"
    Title="LeXi" Style="{StaticResource AppWindow}" Width="720" Height="620" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterScreen"
    Icon="Assets/Lexi.ico" PreviewKeyDown="Window_KeyDown" Activated="Window_Activated">
  <Border Background="{DynamicResource WindowSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="Transparent" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="18,14,10,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent">
            <Path Data="{StaticResource SearchIcon}" Style="{StaticResource IconPath}" Width="18" Height="18" HorizontalAlignment="Left"/>
          </Border>
          <Grid Grid.Column="1">
            <TextBox x:Name="SearchBox" FontSize="21" BorderThickness="0" Background="Transparent" Padding="0,12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown" AutomationProperties.Name="输入单词、短语或待翻译文本"/>
            <TextBlock x:Name="Placeholder" Text="查一个词，或翻译一段文字…" IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="20"/>
          </Grid>
          <StackPanel x:Name="SearchActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <local:QueryProgressView x:Name="QueryProgress" Margin="0,0,4,0"/>
            <Button Style="{StaticResource IconButton}" Click="Search_Click" Margin="0,0,4,0" ToolTip="查询 · Enter" AutomationProperties.Name="查询"><Path Data="{StaticResource EnterIcon}" Style="{StaticResource IconPath}"/></Button>
            <Button Style="{StaticResource IconButton}" Click="Settings_Click" Margin="0,0,4,0" ToolTip="设置 · Ctrl+," AutomationProperties.Name="设置"><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource IconPath}"/></Button>
            <Button Style="{StaticResource IconButton}" Click="Hide_Click" ToolTip="收起 · Esc" AutomationProperties.Name="收起窗口"><Path Data="{StaticResource CloseIcon}" Style="{StaticResource IconPath}"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <ListBox x:Name="Suggestions" Grid.Row="1" Visibility="Collapsed" MaxHeight="180" Margin="12,8" Background="Transparent" BorderThickness="0" Padding="2" FontSize="17" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="Suggestions_Click" PreviewKeyDown="Suggestions_KeyDown" AutomationProperties.Name="词条建议"/>
      <ScrollViewer x:Name="ResultsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,14,16,14">
        <StackPanel>
          <StackPanel x:Name="Welcome">
            <TextBlock Text="随手查，随时懂。" FontSize="26" FontWeight="SemiBold" Margin="4,13,0,8"/>
            <TextBlock Text="词语看释义，文本看翻译。" Foreground="{StaticResource Muted}" FontSize="16" Margin="4,0,0,30"/>
            <TextBlock Text="试着查一下" Foreground="{StaticResource Muted}" FontSize="13" Margin="4,0,0,10"/>
            <Button Tag="telegraph" Click="Example_Click" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,5">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Surface}" Width="28" Height="28" CornerRadius="6"><TextBlock Text="Aa" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Accent}"/></Border>
                <TextBlock Grid.Column="1" Text="telegraph" FontSize="17" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="英英 · 英汉" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Tag="车钟" Click="Example_Click" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,5">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Surface}" Width="28" Height="28" CornerRadius="6"><TextBlock Text="词" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Accent}"/></Border>
                <TextBlock Grid.Column="1" Text="车钟" FontSize="17" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="专业术语" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Tag="The ship is ready to depart." Click="Example_Click" HorizontalContentAlignment="Stretch" Padding="12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Surface}" Width="28" Height="28" CornerRadius="6"><TextBlock Text="译" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Accent}"/></Border>
                <TextBlock Grid.Column="1" Text="The ship is ready to depart." FontSize="17" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="文本翻译" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel x:Name="EntryPanel" Visibility="Collapsed">
            <TextBlock x:Name="EntryHeading" FontSize="20" Margin="0,0,0,12" TextWrapping="Wrap"><Run x:Name="Headword" FontSize="30" FontWeight="SemiBold"/><Run Text="&#160;&#160;"/><Run x:Name="Phonetic" Foreground="{StaticResource Muted}"/><Run x:Name="PhoneticLabel" FontSize="12" Foreground="{StaticResource Muted}"/><InlineUIContainer BaselineAlignment="TextBottom"><Button x:Name="SpeechButton" Click="Speech_Click" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="播放合成发音" AutomationProperties.Name="播放或停止合成发音"><Path Data="{StaticResource SpeakerIcon}" Style="{StaticResource IconPath}"/></Button></InlineUIContainer></TextBlock>
            <StackPanel x:Name="FormsPanel"/>
            <StackPanel x:Name="EtymologyPanel"/>
            <StackPanel x:Name="ReferencePanel"/>
            <StackPanel x:Name="AiPanel"/>
            <StackPanel x:Name="LocalPanel"/>
            <StackPanel x:Name="OnlinePanel"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="14,6">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource LogoSurface}" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center" ToolTip="LeXi"><TextBlock Text="ξ" Foreground="{StaticResource Accent}" FontFamily="Georgia" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="LookupStatus" Grid.Column="1" Text="正在准备词库…" FontSize="13" Margin="10,0,12,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RefreshButton" Content="重新生成" Click="Refresh_Click" Height="32" Padding="10,4" Margin="0,0,10,0" FontSize="13" Background="{StaticResource Surface}" BorderBrush="#565861" BorderThickness="1" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="重新生成当前查询"/>
            <ToggleButton x:Name="OnlineToggle" Style="{StaticResource OnlineSwitch}" Width="112" Click="Online_Click" AutomationProperties.Name="在线补充"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
