{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inputHash": {
      "type": "string"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "equivalent",
              "same_usage",
              "a_covers_b",
              "b_covers_a"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.95,
            "maximum": 1
          },
          "preferred": {
            "type": "string"
          }
        },
        "required": [
          "a",
          "b",
          "relation",
          "confidence",
          "preferred"
        ]
      },
      "description": "Only confident positive grouping relations. Omitted pairs remain separate."
    },
    "overview": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "description": "Select 1 or 2 supplied sense IDs for the central everyday meaning of the query, in importance order. Use [] if uncertain. Do not select two paraphrases of one usage."
    },
    "comparedPairs": {
      "type": "integer",
      "minimum": 0,
      "description": "Must equal the supplied pairCount after all requested pairs have been reviewed."
    }
  },
  "required": [
    "inputHash",
    "pairs",
    "overview",
    "comparedPairs"
  ]
}
