{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "word": {
      "type": "string"
    },
    "found": {
      "type": "boolean"
    },
    "phonetic": {
      "type": "string"
    },
    "senses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "partOfSpeech": {
            "type": "string"
          },
          "english": {
            "type": "string"
          },
          "chinese": {
            "type": "string"
          },
          "register": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "exampleChinese": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "lexicalForm": {
            "type": "string",
            "enum": [
              "word",
              "abbreviation"
            ]
          },
          "expansion": {
            "type": "string"
          },
          "gloss": {
            "type": "string",
            "description": "最多32字的简体中文速览。先保留常用中文译名，再按需用短句解释；字数不足时优先保留译名。没有约定译名才只用解释。保留关键区别、否定与语气。"
          },
          "coreMeaning": {
            "type": "boolean",
            "description": "True only for the central meaning(s) a reader should learn first, normally one, at most two per entry. Determine independently of domain coverage preferences and output order."
          },
          "chineseTerm": {
            "type": "string",
            "description": "本义项的常用简体中文译名，最多32字；无可靠约定译名则为空。chinese 和 gloss 应保留此译名在开头，先给译名再简短解释。"
          }
        },
        "required": [
          "partOfSpeech",
          "english",
          "chinese",
          "register",
          "example",
          "exampleChinese",
          "evidence",
          "lexicalForm",
          "expansion",
          "gloss",
          "coreMeaning",
          "chineseTerm"
        ]
      }
    },
    "wordForms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lemma": {
            "type": "string"
          },
          "partOfSpeech": {
            "type": "string",
            "enum": [
              "verb",
              "noun",
              "adjective",
              "adverb"
            ]
          },
          "forms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "past",
                    "pastParticiple",
                    "presentParticiple",
                    "thirdPerson",
                    "plural",
                    "comparative",
                    "superlative"
                  ]
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "kind",
                "words"
              ]
            }
          }
        },
        "required": [
          "lemma",
          "partOfSpeech",
          "forms"
        ]
      }
    },
    "note": {
      "type": "string"
    },
    "evidenceStatus": {
      "type": "string",
      "enum": [
        "source_based",
        "unverified",
        "unknown"
      ]
    },
    "etymology": {
      "type": "string",
      "description": "用简体中文写1至3句简短语源说明，最多450字符；保留必要的外语词形。不要编造年代、人名或民间缩略语来源，不确定则空字符串。"
    }
  },
  "required": [
    "word",
    "found",
    "phonetic",
    "senses",
    "wordForms",
    "note",
    "evidenceStatus",
    "etymology"
  ]
}
