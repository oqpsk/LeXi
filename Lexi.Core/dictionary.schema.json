{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "word": {"type": "string"},
    "found": {"type": "boolean"},
    "phonetic": {"type": "string"},
    "senses": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "partOfSpeech": {"type": "string"},
        "english": {"type": "string"},
        "chinese": {"type": "string"},
        "register": {"type": "string"},
        "example": {"type": "string"},
        "exampleChinese": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "integer"}}
      },
      "required": ["partOfSpeech", "english", "chinese", "register", "example", "exampleChinese", "evidence"]
    }},
    "wordForms": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lemma": {"type": "string"},
        "partOfSpeech": {"type": "string", "enum": ["verb", "noun", "adjective", "adverb"]},
        "forms": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "enum": ["past", "pastParticiple", "presentParticiple", "thirdPerson", "plural", "comparative", "superlative"]},
            "words": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["kind", "words"]
        }}
      },
      "required": ["lemma", "partOfSpeech", "forms"]
    }},
    "note": {"type": "string"},
    "evidenceStatus": {"type": "string", "enum": ["source_based", "unverified", "unknown"]}
  },
  "required": ["word", "found", "phonetic", "senses", "wordForms", "note", "evidenceStatus"]
}
